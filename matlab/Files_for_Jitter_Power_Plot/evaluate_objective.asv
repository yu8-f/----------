function obj = opt_for_nested(x, M, V)

%% function f = evaluate_objective(x, M, V)
% Function to evaluate the objective functions for the given input vector
% x. x is an array of decision variables and f(1), f(2), etc are the
% objective functions. The algorithm always minimizes the objective
% function hence if you would like to maximize the function then multiply
% the function by negative one. M is the numebr of objective functions and
% V is the number of decision variables. 
%
% This functions is basically written by the user who defines his/her own
% objective function. Make sure that the M and V matches your initial user
% input. Make sure that the 
%
% An example objective function is given below. It has two six decision
% variables are two objective functions.

% f = [];
% %% Objective function one
% % Decision variables are used to form the objective function.
% f(1) = 1 - exp(-4*x(1))*(sin(6*pi*x(1)))^6;
% sum = 0;
% for i = 2 : 6
%     sum = sum + x(i)/4;
% end
% %% Intermediate function
% g_x = 1 + 9*(sum)^(0.25);
% 
% %% Objective function two
% f(2) = g_x*(1 - ((f(1))/(g_x))^2);

%% Kursawe proposed by Frank Kursawe.
% Take a look at the following reference
% A variant of evolution strategies for vector optimization.
% In H. P. Schwefel and R. M�nner, editors, Parallel Problem Solving from
% Nature. 1st Workshop, PPSN I, volume 496 of Lecture Notes in Computer 
% Science, pages 193-197, Berlin, Germany, oct 1991. Springer-Verlag. 
%
% Number of objective is two, while it can have arbirtarly many decision
% variables within the range -5 and 5. Common number of variables is 3.
obj = [];
f_u1 = x(1);
f_u2 = x(2);
P_1 = x(3);
P_2 = x(4);
%Optimization for HM-PLL  
%%% Laplace transform

f = 1e3 : 10e3 : 100e6;
s = 1j .* f .* 2 .* pi;

%% Constants

k = 1.38e-23;
T = 300;
r = 1;

%% Loop parameters

N_1 = 60;
N_2 = 30.14;
N_EFF = (N_2 / (N_2 - 1));
l = 3;          %DSM order
f_REF = 50e6;
f_INT = N_1 * f_REF;
f_OUT = (N_2 / (N_2 - 1)) * f_INT;
f_DSM = f_OUT / N_2;

P_VCO1 = P_1 * 1e-3;
P_VCO2 = P_2 * 1e-3;

%P_VCO1 = 1e-3;
%P_VCO2 = 9e-3;
Q_1 = 10;
Q_2 = 10;

K_VCOn1 = (4*pi*k*T*(1+r) / P_VCO1) * ((f_INT / (2 * Q_1))^2);
K_VCOn2 = (4*pi*k*T*(1+r) / P_VCO2) * ((f_OUT / (2 * Q_2))^2);
K_VCO1 = 2 * pi * 30e6;
K_VCO2 = 2 * pi * 30e6;
I_CP1 = 100e-6;
I_CP2 = 100e-6;
v_ov1 = 0.2;
v_ov2 = 0.2;
t_on1 = 100e-12;
t_on2 = 100e-12;
a1 = 5;
a2 = 5;
w_u1 = 2 * pi * 1e6 * f_u1;
w_u2 = 2 * pi * 1e6 * f_u2;

%% Integer loop filter
C1_INT = a1 * (K_VCO1 / (2 * pi)) * (I_CP1 / (N_1 * (w_u1) ^ 2));
C2_INT = C1_INT / (a1 ^ 2);
R_INT = a1 / (C1_INT * w_u1);
F_LF1 = ((s .* R_INT .* C1_INT) + 1) ./ (((s .^2) .* R_INT .* C1_INT .* C2_INT) + (s .* (C1_INT + C2_INT)));
F_LF1_dB = 20 .* log10(abs(F_LF1));

%% Main loop filter
C1 = a2 * (K_VCO2 / (2 * pi)) * (I_CP2 / (N_EFF * (w_u2) ^ 2));
C2 = C1 / (a2 ^ 2);
R = a2 / (C1 * w_u2);
F_LF = ((s .* R .* C1) + 1) ./ (((s .^2) .* R .* C1 .* C2) + (s .* (C1 + C2)));
F_LF_dB = 20 .* log10(abs(F_LF));

%% Integer loop noise sources
n_psd_in = 1e-16;
n_psd_vco1 = K_VCOn1 ./ (f .^ 2);

%% Main loop noise sources
n_psd_dsm = ( ( (2 * pi) / N_2) ^ 2) .* (1 / 12) .* (1 / f_DSM) .* ( (2 .* sin(pi .* f ./ f_DSM) ) .^ (2 * (l-1) ) );
n_psd_vco2 = K_VCOn2 ./ (f .^ 2);

%% Integer loop transfer functions
H_OL1 = (I_CP1 / (2 * pi)) .* F_LF1 .* (K_VCO1 ./ s) .* (1 / N_1);
H_OL1_dB = 20 .* log10(abs(H_OL1));

H_LP1 = N_1 .* (H_OL1 ./ (1 + H_OL1));
H_LP_dB = 20 .* log10(abs(H_LP1));

H_HP1 = 1 ./ (1 + H_OL1);
H_HP_dB = 20 .* log10(abs(H_HP1));

%% Main loop transfer functions
H_OL2 = (I_CP2 / (2 * pi)) .* F_LF .* (K_VCO2 ./ s) .* (1 / N_EFF);
H_OL2_dB = 20 .* log10(abs(H_OL2));

H_LP2 = N_EFF .* (H_OL2 ./ (1 + H_OL2));
H_LP2_dB = 20 .* log10(abs(H_LP2));

H_HP2 = 1 ./ (1 + H_OL2);
H_HP2_dB = 20 .* log10(abs(H_HP2));

%% Integer loop noise
S_N_IN1 = ((abs(H_LP1)) .^2) * n_psd_in;
S_N_IN1_dB = 10 .* log10(S_N_IN1);

S_N_VCO1 = ((abs(H_HP1)) .^ 2) .* n_psd_vco1;
S_N_VCO1_dB = 10 .* log10(S_N_VCO1);

S_N1 = S_N_IN1 + S_N_VCO1;
S_N1_dB = 10 .* log10(S_N1);

%% Main loop noise
S_N_DSM = ((abs(H_LP2)) .^ 2) .* n_psd_dsm;
S_N_DSM_dB = 10 .* log10(S_N_DSM);

S_N_VCO2 = ((abs(H_HP2)) .^ 2) .* n_psd_vco2;
S_N_VCO2_dB = 10 .* log10(S_N_VCO2);

S_N1_OUT = ((abs(H_LP2)) .^ 2) .* S_N1;
S_N1_OUT_dB = 10 .* log10(S_N1_OUT);

S_N_TOT = S_N1_OUT + S_N_DSM + S_N_VCO2;
S_N_TOT_dB = 10 .* log10(S_N_TOT);

%% Integrated jitter
A_INT = S_N1 .* 10e3;
A_INT_T = sum(A_INT);
J_INT = (sqrt(2 * A_INT_T) ) / (2 * pi * f_INT);

A = S_N_TOT .* 10e3;
A_T = sum(A);
J = (sqrt(2 * A_T) ) / (2 * pi * f_OUT);
P = P_1 + P_2;
obj(1) = J;
obj(2) = P;


end
%% Check for error
if length(obj) ~= M
    error('The number of decision variables does not match you previous input. Kindly check your objective function');
end